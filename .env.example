# Public development placeholders only. Never use these values with real funds.
# Copy to an ignored .env and replace secrets for your own deployment.
#
# Shared infrastructure
#

POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-me

RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=change-me
RABBITMQ_URL=amqp://user:change-me@rabbitmq:5672/

PAYMENT_COMMANDS_QUEUE=payment.lightning.commands
PAYMENT_EVENTS_QUEUE=payment.lightning.events
PAYMENT_COMMANDS_DLQ=payment.lightning.commands.dlq

#
# Dedicated service databases for Docker Compose
#

LEDGER_DATABASE_URL=postgresql+psycopg://app_user:change-me@database/ledger_db
PLS_DATABASE_URL=postgresql+psycopg://app_user:change-me@database/pls_db
HUB_DATABASE_URL=postgresql+psycopg://app_user:change-me@database/hub_db

#
# Ledger settings / compose aliases
#

# Format:
# service_name:token:scope1,scope2;other_service:other-token:scope1,scope2
LEDGER_INTERNAL_API_TOKENS=hub:change-me-hub-ledger-token:read,write;pls:change-me-pls-ledger-token:read,write
HUB_LEDGER_INTERNAL_API_TOKEN=change-me-hub-ledger-token

HOLD_EXPIRATION_INTERVAL_SECONDS=60
HOLD_EXPIRATION_BATCH_SIZE=100
PAYMENT_EVENT_CONSUMER_ENABLED=false

LEDGER_LOG_LEVEL=INFO

#
# PLS settings
#

COMMAND_RETRY_ATTEMPTS=3
COMMAND_RETRY_BACKOFF_SEC=0.1
OUTBOX_PUBLISH_BATCH_SIZE=100
RECONCILIATION_INTERVAL_SECONDS=60
RECONCILIATION_BATCH_SIZE=100

OBSERVABILITY_ENABLED=true
OBSERVABILITY_HOST=0.0.0.0
OBSERVABILITY_PORT=8001

LNBITS_URL=http://lnbits:5000
LNBITS_WALLET_ID=
LNBITS_INVOICE_READ_KEY=
LNBITS_ADMIN_KEY=
LNBITS_USERNAME=
LNBITS_PASSWORD=
LNBITS_INVOICE_TTL=3600

#
# Hub settings / compose aliases
#

LEDGER_BASE_URL=http://ledger:8000
HUB_STORAGE_SECRET=change-me-hub-storage-secret
SESSION_SECRET_KEY=change-me-session-secret
SESSION_HTTPS_ONLY=false

OIDC_CLIENT_ID=hub-local-client
OIDC_CLIENT_SECRET=
OIDC_SERVER_METADATA_URL=http://localhost:8080/realms/leprechaun/.well-known/openid-configuration
OIDC_ISSUER=http://localhost:8080/realms/leprechaun
OIDC_SCOPE=openid profile
OIDC_REDIRECT_PATH=/auth/callback
