{
  "realm": "leprechaun",
  "enabled": true,
  "displayName": "Sats Lottu",
  "sslRequired": "none",
  "loginTheme": "sats-lottu",
  "accountTheme": "sats-lottu",
  "registrationAllowed": false,
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "pt-BR"],
  "defaultLocale": "pt-BR",
  "identityProviders": [
    {
      "alias": "lnurl-auth",
      "providerId": "lnurl-auth",
      "displayName": "Lightning wallet",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {"syncMode": "IMPORT", "guiOrder": "1"}
    },
    {
      "alias": "nostr",
      "providerId": "nostr",
      "displayName": "Nostr",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {"syncMode": "IMPORT", "guiOrder": "2"}
    }
  ],
  "clients": [
    {
      "clientId": "leprechaun-hub",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:${HUB_PORT}${OIDC_REDIRECT_PATH}",
        "http://127.0.0.1:${HUB_PORT}${OIDC_REDIRECT_PATH}"
      ],
      "attributes": {"pkce.code.challenge.method": "S256"}
    }
  ],
  "users": [
    {
      "id": "00000000-0000-0000-0000-000000000300",
      "username": "player",
      "enabled": true,
      "firstName": "Local",
      "lastName": "Player",
      "email": "player@example.test",
      "emailVerified": true,
      "credentials": [
        {"type": "password", "value": "Local-player-123!", "temporary": false}
      ]
    }
  ]
}
